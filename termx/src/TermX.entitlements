<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The runtime needs these two, exactly as Andarium's release IPA is
	     sideloaded with them. They are special Apple entitlements: an adhoc
	     signature cannot grant them, and a free developer profile may not
	     carry them either. Without them the guest still boots, but with the
	     process's normal memory ceiling, so keep the guest at 2048 MiB. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<!-- Debugger JIT is NOT needed: the app runs the gadget (interpreter)
	     engine, so no get-task-allow is required for JIT. A development
	     profile is still the usual way to install a sideloaded IPA. -->
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
