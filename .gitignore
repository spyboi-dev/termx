# Build outputs
termx/build/
# Large local-only trees (never pushed)
vendor/
upstream/
upstream-newterm/
# Boot-base producer work/output/logs (the built archive lives in boot-base/)
bootbase-work/
bootbase-out/
bootbase-build*.log
# The Linux runtime framework (53 MB, built by CI from the pinned
# Kernarium commit): not in git — a `git add -A` must never stage it.
# Its provenance (upstream commit, SHA-256) is recorded in
# termx/Frameworks/README.md, and the app bakes the hash in at build
# time so About can show it.
termx/Frameworks/KRuntime_6_18_4K.framework/
# Slim image build outputs (large, reproducible from the scripts)
rootfs-build/rootfs-slim/
rootfs-build/*.ext4
rootfs-build/*.ext4.gz
rootfs-build/tmp/
rootfs-build/*.log
# Crash logs are diagnosis scratch, not source
termx/CRASH-*.txt
*.ipa
*.dSYM
.DS_Store
# The localhost bridge binary (a build output from
# rootfs-build/tx-vsock-bridge.c; rebuild with
# aarch64-linux-gnu-gcc -static -O2 -o tx-vsock-bridge tx-vsock-bridge.c).
rootfs-build/tx-vsock-bridge
termx/helper-artifact/
# The on-device pairing library (Rust, built by CI from
# termx/rppairing): not in git — a `git add -A` must never stage it.
termx/rppairing-artifact/
termx/rppairing/target/
